<?xml version="1.0" encoding="utf-8"?>
<!--
    TextureView instead of the default SurfaceView so the video composes cleanly
    with the player's own overlays and Picture-in-Picture. The controller is off
    because the player draws its own Compose controls and gestures.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:resize_mode="fit"
    app:surface_type="texture_view"
    app:use_controller="false" />
